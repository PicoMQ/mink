# syntax=docker/dockerfile:1

FROM rust:1-bookworm AS build
WORKDIR /src

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
 && rm -rf /var/lib/apt/lists/*

ARG PROFILE=release
COPY . .
RUN --mount=type=cache,id=mink-target,sharing=locked,target=/src/target \
    --mount=type=cache,id=mink-cargo-registry,sharing=locked,target=/usr/local/cargo/registry \
    --mount=type=cache,id=mink-cargo-git,sharing=locked,target=/usr/local/cargo/git \
    cargo build --locked --profile "$PROFILE" -p mink-query-cli \
 && mkdir -p /out \
 && cp "/src/target/$( [ "$PROFILE" = dev ] && echo debug || echo "$PROFILE" )/mink-query" /out/mink-query

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/mink-query /usr/local/bin/mink-query

EXPOSE 9130
ENTRYPOINT ["mink-query"]
CMD ["serve"]
